spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/rag_demo?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: your-mysql-username
    password: your-mysql-password

  rabbitmq:
    host: 127.0.0.1
    port: 5672
    username: admin
    password: 123456
    virtual-host: /

  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password: 123456
      database: 0
      timeout: 3000ms

  mail:
    host: smtp.qq.com
    port: 465
    username: your-email@qq.com
    password: your-smtp-password

  ai:
    openai:
      api-key: your-openai-key
      base-url: https://api.openai.com
