spring:
  # === RabbitMQ 配置（本地示例，按需修改）===
  rabbitmq:
    host: 127.0.0.1
    port: 5672
    # 本地默认可用 guest/guest（仅限本机开发），也可改为你自己的账号密码
    username: REPLACE_WITH_YOUR_RABBITMQ_USERNAME
    password: REPLACE_WITH_YOUR_RABBITMQ_PASSWORD
    virtual-host: /

  # === Redis 配置（本地示例，按需修改）===
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      # 如果你的本地 Redis 没有密码，可置空: ""
      password: REPLACE_WITH_YOUR_REDIS_PASSWORD
      database: 0
      timeout: 3000ms
